# Automatic HTTPS (Let's Encrypt) for the domain in $DOMAIN.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Limit request bodies (bulk import is the largest: 1 MB).
	request_body {
		max_size 2MB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
	}
}

# Redirect www → apex
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
