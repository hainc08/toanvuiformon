# ── Local development (npm run dev) ──────────────────────────
DATABASE_URL="mysql://toanvui:toanvui@localhost:3306/toanvui"
SITE_URL="http://localhost:3000"
# >= 32 random chars:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Optional: path to a Chromium binary for PDF rendering. Leave empty to use Playwright's browser
# (install once with: npx playwright install chromium-headless-shell)
CHROMIUM_PATH=""
PDF_MAX_CONCURRENCY=2
# "true" only behind a reverse proxy that sets X-Forwarded-For (Caddy in docker-compose)
TRUST_PROXY="false"

# Seed options
# SEED_PUBLISH_VERIFIED="false"   # keep every seeded question in review
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Tests
TEST_DATABASE_URL="mysql://toanvui:toanvui@localhost:3306/toanvui_test"

# ── Production (Hostinger Node.js Web App → hPanel Environment variables) ──
# SITE_URL="https://violet-ram-565010.hostingersite.com"
