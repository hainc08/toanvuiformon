# ── Local development (npm run dev) ──────────────────────────
DATABASE_URL="postgresql://toanvui:toanvui@localhost:5432/toanvui?schema=public"
SITE_URL="http://localhost:3000"
# >= 32 random chars:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Optional: path to a Chromium binary for PDF rendering. Leave empty to use Playwright's browser
# (install once with: npx playwright install chromium-headless-shell)
CHROMIUM_PATH=""
PDF_MAX_CONCURRENCY=2
# "true" only behind a reverse proxy that sets X-Forwarded-For (Caddy in docker-compose)
TRUST_PROXY="false"

# Seed options
# SEED_PUBLISH_VERIFIED="false"   # keep every seeded question in review
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Tests
TEST_DATABASE_URL="postgresql://toanvui:toanvui@localhost:5432/toanvui_test?schema=public"

# ── Production (docker-compose.yml on the VPS) ───────────────
# DOMAIN="toanvui.vn"
# SITE_URL="https://toanvui.vn"
# POSTGRES_USER="toanvui"
# POSTGRES_PASSWORD="<strong random password>"
# POSTGRES_DB="toanvui"
# SESSION_SECRET="<openssl rand -base64 48>"
